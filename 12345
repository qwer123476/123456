        local targetTextY = 0.62
        local targetSubY = 0.74
        
        textLabel.Position = UDim2.new(0.1, 0, targetTextY + 0.02, 0)
        subTextLabel.Position = UDim2.new(0.1, 0, targetSubY + 0.02, 0)
        
