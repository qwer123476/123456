local function restoreSkybox()
    local currentSky = Lighting:FindFirstChildOfClass("Sky")
    if currentSky then
        if originalSkybox.SkyboxBk then
            currentSky.SkyboxBk = originalSkybox.SkyboxBk
            currentSky.SkyboxDn = originalSkybox.SkyboxDn
            currentSky.SkyboxFt = originalSkybox.SkyboxFt
            currentSky.SkyboxLf = originalSkybox.SkyboxLf
            currentSky.SkyboxRt = originalSkybox.SkyboxRt
            currentSky.SkyboxUp = originalSkybox.SkyboxUp
        else
            if currentSky.Name == "PacaCinematicSky" then currentSky:Destroy() end
        end
    end
    originalSkybox = {}
end

