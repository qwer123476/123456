        TweenService:Create(subTextStroke, TweenInfo.new(0.4), {Transparency = 0.2}):Play()
        
        if data.image then
            effectImage.Image = data.image
            effectImage.Size = data.imgSize or UDim2.new(0, 200, 0, 200)
            effectImage.Position = UDim2.new(0.5, 0, 0.33, 0)
            TweenService:Create(effectImage, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {ImageTransparency = 0.1, Position = UDim2.new(0.5, 0, 0.35, 0)}):Play()
        end

        local effectActive = true
        if data.effect == "rainbow" then
            task.spawn(function()
                local textHue = 0
                while effectActive and not isSkipped do
                    local rainbowColor = Color3.fromHSV(textHue, 0.65, 1)
                    textLabel.TextColor3 = rainbowColor
                    textHue = textHue + (2/360)
                    if textHue >= 1 then textHue = 0 end
                    task.wait(0.02)
                end
            end)
        elseif data.effect == "shake" then
            task.spawn(function()
                while effectActive and not isSkipped do
                    local offsetX = math.random(-2, 2)
                    local offsetY = math.random(-2, 2)
                    textLabel.Position = UDim2.new(0.1, offsetX, targetTextY, offsetY)
                    subTextLabel.Position = UDim2.new(0.1, offsetX, targetSubY, offsetY)
                    task.wait(0.03)
                end
                textLabel.Position = UDim2.new(0.1, 0, targetTextY, 0)
                subTextLabel.Position = UDim2.new(0.1, 0, targetSubY, 0)
            end)
        elseif data.effect == "glitch" then
            task.spawn(function()
                while effectActive and not isSkipped do
                    local trans = math.random(0, 3) * 0.1
                    textLabel.TextTransparency = trans
                    subTextLabel.TextTransparency = trans + 0.2
                    if data.image then effectImage.ImageTransparency = trans + 0.1 end
                    task.wait(0.05)
                end
                textLabel.TextTransparency = 0
                subTextLabel.TextTransparency = 0.2
                if data.image then effectImage.ImageTransparency = 0.1 end
            end)
        end

        dualTypeWrite(textLabel, subTextLabel, data.text, data.subText, data.delay)
        
        local totalHoldFrames = math.floor(data.hold / 0.05)
        for _ = 1, totalHoldFrames do
            if isSkipped then effectActive = false return end
            task.wait(0.05)
        end
        
        effectActive = false
        if isSkipped then return end
        
        local textFade = TweenService:Create(textLabel, TweenInfo.new(0.35), {TextTransparency = 1, Position = UDim2.new(0.1, 0, targetTextY - 0.02, 0)})
