local function clearAllEffects()
    rainbowActive = false
    restoreSkybox()
    
    if introSound then
        pcall(function() introSound:Stop() end)
        introSound:Destroy()
        introSound = nil
    end
    
    if currentSound then
        pcall(function() currentSound:Stop() end)
        currentSound:Destroy()
        currentSound = nil
    end
    
    for _, tween in ipairs(lightingTweens) do
        if tween.PlaybackState == Enum.TweenStatus.Playing then
            tween:Cancel()
        end
    end
    lightingTweens = {}
    
    -- [추가] 백업한 원래 맵의 조명 환경으로 완전 원상복구
    if originalLightingState.Ambient then
        for prop, val in pairs(originalLightingState) do
            pcall(function() Lighting[prop] = val end)
        end

        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Atmosphere") or obj:IsA("Sky") or obj:IsA("BloomEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") then
                obj:Destroy()
            end
        end

        for _, origObj in pairs(originalInstances) do
            origObj:Clone().Parent = Lighting
        end
    else
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.Ambient = Color3.fromRGB(0, 0, 0)
    end
    
    if activeScreenGui then
        activeScreenGui:Destroy()
        activeScreenGui = nil
    end
    
    isCutscenePlaying = false
end

