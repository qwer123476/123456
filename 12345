local function dualTypeWrite(mainLabel, subLabel, mainText, subText, delayTime)
    mainLabel.Text = ""
    subLabel.Text = ""
    
    local maxLen = math.max(#mainText, #subText)
    local playedSound = false
    
    for i = 1, maxLen do
        if isSkipped then break end
        
        playedSound = false
        if i <= #mainText then
            mainLabel.Text = string.sub(mainText, 1, i)
            if string.sub(mainText, i, i) ~= " " then playedSound = true end
        end
        
        if i <= #subText then
            subLabel.Text = string.sub(subText, 1, i)
            if string.sub(subText, i, i) ~= " " then playedSound = true end
        end
        
        if playedSound then
            typeSound.TimePosition = 0
            pcall(function() typeSound:Play() end)
        end
        task.wait(delayTime or 0.04)
    end
end

local function typeWrite(textLabel, text, delayTime)
    textLabel.Text = ""
    for i = 1, #text do
        if isSkipped then break end
        textLabel.Text = string.sub(text, 1, i)
        if string.sub(text, i, i) ~= " " then
            typeSound.TimePosition = 0
            pcall(function() typeSound:Play() end)
        end
        task.wait(delayTime or 0.04)
    end
end

