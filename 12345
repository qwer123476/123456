        if data.image then
            TweenService:Create(effectImage, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {ImageTransparency = 1, Position = UDim2.new(0.5, 0, 0.37, 0)}):Play()
        end
        
        textFade.Completed:Wait()
        task.wait(0.3)
    end

